# Supabase Postgres — used by scripts/db_backup.sh. Use the SESSION pooler URI
# (port 5432) from Supabase → Project Settings → Database → Connection string,
# and keep sslmode=require. The direct db.<ref>.supabase.co host is IPv6-only.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Remote TLS verification is enabled by default. Set the CA certificate as a
# newline-escaped value when the host CA bundle does not contain the issuer.
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
BACKUP_DIR=

# Required in production. Production startup refuses to run without Supabase
# authentication when APP_ENV=production.
APP_ENV=development
# API docs at /api/docs (default: enabled only in development).
# SWAGGER_ENABLED=true

# Frontend Supabase auth — copy these into frontend/.env.local (Next.js reads
# env from the frontend directory, not the repo root).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the frontend — used to build Supabase invite redirectTo links.
# Change to your production domain when deploying.
APP_URL=http://localhost:5050

# Optional comma-separated additional browser origins. APP_URL is always
# allowed. Keep this narrow in production.
CORS_ORIGINS=

# Optional HTTPS webhook for privacy-safe API 5xx notifications. Payloads
# contain request metadata only, never request bodies, tokens, or file data.
ALERT_WEBHOOK_URL=

# Resend — sends user invite emails from the backend.
# Use a From address on a domain verified in your Resend account
# (e.g. "TCH Financials <noreply@yourdomain.com>").
# Falls back to beth.t@example.com only if unset (may fail once a custom domain is verified).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required absolute path in production. Keep media and backups on persistent,
# separately backed-up storage rather than inside the code checkout.
MEDIA_ROOT=

# Creator social imports: server-only. Reads never contact Bright Data.
# Apply migrations and start worker:social separately before enabling imports.
BRIGHTDATA_IMPORTS_ENABLED=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_IG_DATASET_ID=
# Reserved for a later explicit deeper-content import; unused in the first release.
BRIGHTDATA_IG_POSTS_DATASET_ID=
SOCIAL_REFRESH_COOLDOWN_SECONDS=3600
SOCIAL_CREATOR_DAILY_LIMIT=3
SOCIAL_GLOBAL_DAILY_LIMIT=100

# OpenAI — used for AI concept generation in Campaign Briefs.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4o-mini
